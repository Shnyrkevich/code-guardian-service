# Code Guardian configuration. Every variable is optional; the values below are the defaults.
# The app does not read this file by itself. Copy it to .env and start with:
#   node --env-file=.env dist/index.js

# HTTP port the API listens on.
PORT=3000

# Redis connection used for the BullMQ job queue and for scan state/results.
# Format: redis://[:password@]host:port[/db]
REDIS_URL=redis://localhost:6379

# Directory for per-scan data (cloned repo + Trivy report), one subfolder per scan:
#   <SCAN_WORK_DIR>/<scanId>/repo  and  <SCAN_WORK_DIR>/<scanId>/report.json
# Relative paths are resolved against the current directory. Wiped on startup, because anything
# left there belongs to a crashed process, so never point it at a directory you care about.
# Must be shared with Docker (the Trivy container mounts it) and have room for the largest report.
SCAN_WORK_DIR=.scan-work

# Debug: keep the clone and report after a scan instead of deleting them (they are still
# wiped on startup and before a retry). Leave false in normal use.
KEEP_WORK_FILES=false

# Docker image used to run Trivy.
TRIVY_IMAGE=aquasec/trivy:latest

# Docker named volume that caches the Trivy vulnerability DB between scans.
TRIVY_CACHE_VOLUME=trivy-cache

# Number of scans processed in parallel by this process. Each one runs a clone and a Trivy
# container, so keep it low on small pods.
WORKER_CONCURRENCY=1

# How many `git clone` runs may happen at the same time. Clones are the memory-heavy step and run
# inside the app container, so they take turns even when WORKER_CONCURRENCY is higher: the other
# workers wait for their turn to clone, while Trivy and the report parsing still overlap.
# Several large clones at once can exceed a small container's memory limit.
CLONE_CONCURRENCY=1

# Total tries per scan (first run + retries). The scan becomes Failed only after the last one.
JOB_ATTEMPTS=2

# How long a worker owns a job before BullMQ may consider it stalled. It is renewed
# automatically while the process is alive, so after a crash this is roughly how long
# until the job is picked up again.
LOCK_DURATION_MS=60000

# Timeout for each external command (git clone, Trivy). The process is killed after this.
COMMAND_TIMEOUT_MS=900000

# Max CRITICAL vulnerabilities stored per scan. Extra ones are counted in criticalCount,
# and the scan is flagged truncated=true. Protects Redis memory.
MAX_CRITICALS=10000

# CRITICAL vulnerabilities written to Redis per batch while streaming the report.
BATCH_SIZE=500

# How long scan records and results are kept in Redis (seconds). Default: 24h.
SCAN_TTL_SECONDS=86400

# --- docker compose only (docker-compose.yml reads these; the app itself does not) ---

# Host port for the app container.
# APP_PORT=3000

# Host folder for scan data. It is mounted into the app container at the SAME path, because the
# app starts Trivy with `docker run -v <path>:/work` and the Docker daemon resolves that path on
# the host. It must be a folder Docker may share (on macOS: under /Users, /tmp or /private).
# SCAN_HOST_DIR=/tmp/code-guardian

# Redis URL the app container uses. Change the database number (/5) to isolate it from another
# instance sharing the same Redis, for example a dev server running on the host.
# APP_REDIS_URL=redis://redis:6379

# Host port for the web page (nginx container).
# WEB_PORT=8080
